{
    "tasks": [
        {
            "label": "Build and Run",
            "type": "shell",
            "command": "cmake --build build && ./build/BackTester",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Debug Build",
            "type": "shell",
            "command": "cmake --build build && ./build/BackTester",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "Time Run",
            "type": "shell",
            "command": "time ${workspaceFolder}/main",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        }
    ],
    "version": "2.0.0"
}